{
  "name": "@mastra/memory",
  "version": "1.39.1",
  "description": "",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./processors": {
      "import": {
        "types": "./dist/processors/index.d.ts",
        "default": "./dist/processors/index.js"
      },
      "require": {
        "types": "./dist/processors/index.d.ts",
        "default": "./dist/processors/index.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      },
      "require": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "async-mutex": "^0.5.0",
    "diff": "^8.0.4",
    "json-schema": "^0.4.0",
    "lru-cache": "^11.5.3",
    "probe-image-size": "^7.4.0",
    "xxhash-wasm": "^1.1.0",
    "zod": "^4.6.7",
    "@mastra/schema-compat": "1.3.17"
  },
  "devDependencies": {
    "@ai-sdk/openai-v5": "npm:@ai-sdk/openai@2.0.135",
    "@copilotkit/aimock": "^1.46.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "22.19.15",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "tokenx": "^1.6.0",
    "tsdown": "0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "4.1.12",
    "@internal/ai-sdk-v5": "0.0.93",
    "@internal/ai-v6": "0.0.93",
    "@internal/ai-v7": "0.0.93",
    "@internal/lint": "0.0.146",
    "@internal/types-builder": "0.0.121",
    "@internal/ai-sdk-v4": "0.0.93",
    "@mastra/core": "1.80.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.80.0-0 <2.0.0-0"
  },
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "packages/memory"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "tsc --noEmit && pnpm check:scripts",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "build:lib": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build:lib --watch",
    "test:integration": "cd integration-tests && pnpm run test",
    "test:unit": "pnpm vitest run",
    "test:simulate": "vitest run --root scripts/simulate",
    "test": "pnpm test:integration && pnpm test:unit && pnpm test:simulate",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "analyze:om-repro": "node ./scripts/analyze-om-repro.mjs",
    "sanitize:om-repro": "node ./scripts/sanitize-om-repro.mjs",
    "simulate:extract": "tsx ./scripts/simulate/extract.ts",
    "simulate:replay": "tsx ./scripts/simulate/replay.ts"
  }
}